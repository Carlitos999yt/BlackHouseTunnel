<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="NepTunnel.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:neptunnel="clr-namespace:NepTunnel;assembly=NepTunnel">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="BgColor">#08040F</Color>
      <Color x:Key="CardColor">#130B22</Color>
      <Color x:Key="Card2Color">#1C1035</Color>
      <Color x:Key="BordColor">#3A1A68</Color>
      <Color x:Key="AccColor">#8B5CF6</Color>
      <Color x:Key="GlowColor">#C4B5FD</Color>
      <Color x:Key="MoonColor">#F5F0FF</Color>
      <Color x:Key="TextColor">#F0E6FF</Color>
      <Color x:Key="MuteColor">#8B7AAA</Color>
      <Color x:Key="OkColor">#10B981</Color>
      <Color x:Key="ErrColor">#EF4444</Color>
      <Color x:Key="WarnColor">#F59E0B</Color>
      <Color x:Key="BlueColor">#6366F1</Color>
      <Color x:Key="TealColor">#14B8A6</Color>
      <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
      <SolidColorBrush x:Key="Card2Brush" Color="{StaticResource Card2Color}" />
      <SolidColorBrush x:Key="BordBrush" Color="{StaticResource BordColor}" />
      <SolidColorBrush x:Key="AccBrush" Color="{StaticResource AccColor}" />
      <SolidColorBrush x:Key="GlowBrush" Color="{StaticResource GlowColor}" />
      <SolidColorBrush x:Key="MoonBrush" Color="{StaticResource MoonColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="MuteBrush" Color="{StaticResource MuteColor}" />
      <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
      <SolidColorBrush x:Key="ErrBrush" Color="{StaticResource ErrColor}" />
      <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
      <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
      <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
      <Style x:Key="DarkScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Border Name="ThumbBorder" Background="#4C2582" CornerRadius="4" Margin="2" />
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ThumbBorder" Property="Border.Background" Value="#8B5CF6" />
                </Trigger>
                <Trigger Property="Thumb.IsDragging" Value="True">
                  <Setter TargetName="ThumbBorder" Property="Border.Background" Value="#C4B5FD" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Name="Bg" Background="#00FFFFFF" SnapsToDevicePixels="True">
                <Track Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                  <Track.Thumb>
                    <Thumb Style="{StaticResource DarkScrollBarThumb}" />
                  </Track.Thumb>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ScrollBar.Orientation" Value="Vertical">
                  <Setter Property="Width" Value="10" />
                  <Setter Property="MinHeight" Value="36" />
                </Trigger>
                <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
                  <Setter Property="Height" Value="10" />
                  <Setter Property="MinWidth" Value="36" />
                  <Setter TargetName="PART_Track" Property="Track.IsDirectionReversed" Value="False" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="WinCaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="UIElement.RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="1" ScaleY="1" />
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}">
                <ContentPresenter Name="content" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#2A134D" Duration="0:0:0.14">
                        <ColorAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </ColorAnimation.EasingFunction>
                      </ColorAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00000000" Duration="0:0:0.18">
                        <ColorAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </ColorAnimation.EasingFunction>
                      </ColorAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="WinCloseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource WinCaptionButtonStyle}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}">
                <ContentPresenter Name="content" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#EF4444" Duration="0:0:0.14">
                        <ColorAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </ColorAnimation.EasingFunction>
                      </ColorAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00000000" Duration="0:0:0.18">
                        <ColorAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </ColorAnimation.EasingFunction>
                      </ColorAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>