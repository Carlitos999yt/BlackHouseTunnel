<Window x:Class="BlackHouseTunnel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlackHouseTunnel" Height="700" Width="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border x:Name="WindowBorder" 
            Background="#060609" 
            BorderBrush="#1E1E2C" 
            BorderThickness="1.5" 
            CornerRadius="12">
        
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom Title Bar -->
                <RowDefinition Height="38"/>
                <!-- Main App Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLE BAR -->
            <Border Grid.Row="0" 
                    x:Name="TitleBar"
                    Background="#0A0A0F" 
                    CornerRadius="12,12,0,0" 
                    BorderBrush="#181824" 
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Brand Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09c-.01-.02-.04-.03-.07-.03c-1.5.26-2.93.71-4.27 1.33c-.01 0-.02.01-.03.02C2.1 9.3 1.33 13.16 1.7 16.97c0 .02.01.04.03.05c1.78 1.31 3.5 2.11 5.17 2.63c.03.01.06 0 .07-.02c.4-.55.76-1.13 1.07-1.74c.02-.04 0-.09-.04-.11c-.57-.22-1.11-.48-1.63-.78c-.04-.02-.04-.08 0-.11c.11-.08.22-.17.33-.25c.02-.02.05-.02.07-.01c3.44 1.57 7.15 1.57 10.55 0c.02-.01.05-.01.07.01c.11.09.22.17.33.26c.04.03.04.09 0 .11c-.52.31-1.07.56-1.64.78c-.04.02-.05.07-.04.11c.32.61.68 1.19 1.07 1.74c.01.02.04.03.07.02c1.68-.52 3.4-1.32 5.18-2.63c.02-.01.03-.03.03-.05c.44-4.38-.73-8.21-3.1-11.62c-.01-.01-.02-.02-.03-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.83 2.12-1.89 2.12z"
                              Fill="#5865F2" Width="16" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="BLACKHOUSE" 
                                   FontFamily="Cinzel, Times New Roman, Segoe UI Black, Georgia, sans-serif" 
                                   FontSize="13" 
                                   FontWeight="Bold" 
                                   FontStyle="Italic"
                                   Foreground="#EEEEEE" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="TUNNEL" 
                                   FontFamily="Segoe UI" 
                                   FontSize="10" 
                                   FontWeight="Bold" 
                                   Foreground="#5865F2" 
                                   Margin="6,0,0,0" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Draggable Space -->
                    <Grid Grid.Column="1" Background="Transparent"/>

                    <!-- Custom Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize Button -->
                        <Button x:Name="BtnMinimize" 
                                Width="36" Height="28" 
                                Background="Transparent" 
                                Foreground="#CCCCCC" 
                                BorderThickness="0" 
                                Cursor="Hand"
                                Click="BtnMinimize_Click">
                            <TextBlock Text="🗕" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="BtnMaximize" 
                                Width="36" Height="28" 
                                Background="Transparent" 
                                Foreground="#CCCCCC" 
                                BorderThickness="0" 
                                Cursor="Hand"
                                Click="BtnMaximize_Click">
                            <TextBlock x:Name="TxtMaximizeIcon" Text="🗖" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="BtnClose" 
                                Width="36" Height="28" 
                                Background="Transparent" 
                                Foreground="#CCCCCC" 
                                BorderThickness="0" 
                                Cursor="Hand"
                                Click="BtnClose_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#ED4245"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="✕" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN VIEW CONTAINER -->
            <Grid Grid.Row="1" x:Name="MainContainer">
                <!-- Views loaded dynamically here -->
            </Grid>
        </Grid>
    </Border>
</Window>
