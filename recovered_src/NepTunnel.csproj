    <EmbeddedResource Include="mainwindow.baml" LogicalName="mainwindow.baml" />
    <EmbeddedResource Include="bundled_assets\nepbridgeplugin.lua" LogicalName="bundled_assets/nepbridgeplugin.lua" />
    <EmbeddedResource Include="bundled_assets\tut_8.png" LogicalName="bundled_assets/tut_8.png" />
