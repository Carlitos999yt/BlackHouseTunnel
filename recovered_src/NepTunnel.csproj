    <None Remove="bundled_assets\robloxstudiomodmanager.exe" />
    <None Remove="mainwindow.baml" />
    <None Remove="bundled_assets\nepbridgeplugin.lua" />
    <None Remove="bundled_assets\tut_8.png" />
    <None Remove="bundled_assets\tut_9.png" />
    <None Remove="bundled_assets\tut_4.png" />
    <None Remove="bundled_assets\tut_6.png" />
    <None Remove="bundled_assets\tut_5.png" />
    <None Remove="bundled_assets\tut_7.png" />
    <None Remove="bundled_assets\tut_2.png" />
    <None Remove="bundled_assets\tut_1.png" />
    <None Remove="bundled_assets\tut_3.png" />
    <None Remove="bundled_assets\default_baseplate.rbxlx" />
    <None Remove="app.baml" />
    <None Remove="icon.ico" />
    <None Remove="bundled_assets\banner.jpg" />
    <EmbeddedResource Include="bundled_assets\nepnamesyncscript.luau" LogicalName="bundled_assets/nepnamesyncscript.luau" />
